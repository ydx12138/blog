# 将本文件复制为 .env 后，填写实际值。不要将 .env 提交到 Git 仓库。

# Docker Compose：MySQL 容器初始化
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=blog
MYSQL_PORT=3306

# 应用配置：MySQL
BLOG_MYSQL_PASSWORD=your_mysql_password
BLOG_MYSQL_DATABASE=blog
BLOG_MYSQL_PORT=3306

# 应用配置：Redis
BLOG_REDIS_PORT=6379
# BLOG_REDIS_PASSWORD=your_redis_password

# 邮件服务
BLOG_MAIL_USERNAME=your_email@example.com
BLOG_MAIL_PASSWORD=your_mail_authorization_code

# 阿里云 OSS
BLOG_OSS_ACCESS_KEY_ID=your_oss_access_key_id
BLOG_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
BLOG_OSS_DEFAULT_AVATAR=https://example.com/default-avatar.jpg

# 短信服务
BLOG_SMS_ACCESS_KEY_ID=your_sms_access_key_id
BLOG_SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret

# 微信小程序
BLOG_WECHAT_APP_ID=your_wechat_mini_program_app_id
BLOG_WECHAT_APP_SECRET=your_wechat_mini_program_app_secret

# 预留给部署脚本使用的端口变量
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
APP_PORT=8080
